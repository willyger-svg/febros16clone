# FEBROS16 Backend Environment Configuration
# Copy this to .env for local development

# HTTP Server Port (Render automatically sets PORT in production)
PORT=8080

# PostgreSQL Connection String (Render provides this via DATABASE_URL)
DATABASE_URL=postgres://febros_user:password123@localhost:5432/febros16_db?sslmode=disable

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://febros16.com,http://localhost:3000

# Application Environment (development | production)
ENV=development
