# ========================================================
# FEBROS16 BACKEND ENVIRONMENT VARIABLES
# ========================================================

PORT=8080
ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgres://user:password@localhost:5432/febros16_db?sslmode=disable

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# JWT Configuration
JWT_SECRET=super_secret_signing_key_replace_in_production

# Frontend Client URL (For redirects and CORS)
FRONTEND_URL=http://localhost:3000
